# Режим Telegram:
# user — личный аккаунт через Telethon; нужны API_ID и API_HASH.
# bot — бот BotFather; нужен TELEGRAM_BOT_TOKEN, API_ID и API_HASH не используются.
TELEGRAM_MODE=user
TELEGRAM_SESSION_PATH=.sessions/nikita

# Нужен только для TELEGRAM_MODE=bot. Получить у @BotFather.
# Не публикуй настоящий токен: добавляй его только в локальный .env или secrets хостинга.
TELEGRAM_BOT_TOKEN=

# Нужны только для TELEGRAM_MODE=user. Получить: https://my.telegram.org.
# Настоящие значения храни только в .env — не добавляй этот файл в Git.
API_ID=
API_HASH=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Локальная генерация голоса (скачанные файлы не добавляются в Git).
PIPER_VOICE_PATH=.models/piper/ru_RU-ruslan-medium.onnx

# Локальная генерация изображений (скачанные файлы не добавляются в Git).
SD_CPP_PATH=.tools/stable-diffusion/sd-cli.exe
SD_TURBO_MODEL_PATH=.models/sd-turbo/sd_turbo-f16-q8_0.gguf

# Разрешить пользовательской сессии обрабатывать сообщения других ботов.
ALLOW_BOT_SENDERS=true

# Ответы и инициативные сообщения в группах.
GROUP_REPLY_PROBABILITY=1.0
PROACTIVE_GROUP_ENABLED=true
PROACTIVE_GROUP_CHANCE=0.02
PROACTIVE_GROUP_COOLDOWN_MINUTES=60
PROACTIVE_GROUP_MIN_MESSAGES=5

# Количество последних сообщений в контексте каждого чата.
MAX_HISTORY_MESSAGES=16